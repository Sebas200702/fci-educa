---
import { ORG_URL, socialLinks } from '../lib/site';

const redes = [
  { nombre: 'Instagram', href: socialLinks.instagram },
  { nombre: 'Facebook', href: socialLinks.facebook },
  { nombre: 'LinkedIn', href: socialLinks.linkedin },
  { nombre: 'YouTube', href: socialLinks.youtube },
];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__org">
      <p class="footer__title">Una línea de la Fundación Colombia Incluyente</p>
      <p>Formación, empleo e inclusión para personas, empresas y aliados.</p>
      <a class="btn btn--primary" href={ORG_URL}>
        Conoce la Fundación
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
      </a>
    </div>
    <nav aria-label="Redes sociales">
      <ul class="footer__redes">
        {redes.map((r) => <li><a href={r.href} rel="noopener">{r.nombre}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="wrap footer__legal">
    <p>© {year} Fundación Colombia Incluyente</p>
  </div>
</footer>

<style>
  .footer {
    padding-top: var(--section-y);
    background: var(--sun-soft);
  }

  .footer__grid {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer__org {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 30rem;
  }

  .footer__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.375rem, 2.6vw, 1.75rem);
    color: var(--neutral-900);
    line-height: 1.2;
  }

  .footer__redes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .footer__redes a {
    text-decoration: none;
    padding-block: 0.5rem;
  }

  .footer__redes a:hover {
    color: var(--brand-700);
  }

  .footer__legal {
    padding-block: 1.5rem;
    border-top: 1px solid color-mix(in oklab, var(--neutral-900) 10%, transparent);
    font-size: 0.8125rem;
    color: var(--neutral-600);
  }

  @media (min-width: 56rem) {
    .footer__grid {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
