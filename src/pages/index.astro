---
import BaseLayout from '../layouts/base-layout.astro';
import Diplomados from '../components/diplomados.astro';
import Hero from '../components/hero.astro';
import Materiales from '../components/materiales.astro';
import Oferta from '../components/oferta.astro';
import SiteFooter from '../components/site-footer.astro';
import SiteHeader from '../components/site-header.astro';
---

<BaseLayout
  title="Colombia Incluyente Educa · Fundación Colombia Incluyente"
  description="Plataforma de formación virtual de la Fundación Colombia Incluyente: habilidades socioemocionales, digitales, técnicas y verdes. Materiales del Diplomado Constructor Social de Territorios de Paz."
>
  <SiteHeader />
  <main id="contenido">
    <Hero />
    <Oferta />
    <Diplomados />
    <Materiales />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  // Fade-in on scroll. Without JS (or with reduced motion) everything is visible from the start.
  const root = document.documentElement
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    root.classList.add('js')
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible')
            io.unobserve(e.target)
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    )
    for (const el of document.querySelectorAll('.reveal')) io.observe(el)
  }
</script>
